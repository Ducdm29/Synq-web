{
  "redirects": [
    {"source": "/shadowblade", "destination": "/kagezan", "permanent": true},
    {"source": "/shadowblade.html", "destination": "/kagezan", "permanent": true},
    {"source": "/shadowblade-privacy", "destination": "/kagezan-privacy", "permanent": true},
    {"source": "/shadowblade-privacy.html", "destination": "/kagezan-privacy", "permanent": true},
    {"source": "/shadowblade-terms", "destination": "/kagezan-terms", "permanent": true},
    {"source": "/shadowblade-terms.html", "destination": "/kagezan-terms", "permanent": true},
    {"source": "/shadowblade-support", "destination": "/kagezan-support", "permanent": true},
    {"source": "/shadowblade-support.html", "destination": "/kagezan-support", "permanent": true},
    {"source": "/shadowblade-delete-account", "destination": "/kagezan-delete-account", "permanent": true},
    {"source": "/shadowblade-delete-account.html", "destination": "/kagezan-delete-account", "permanent": true},
    {"source": "/guides", "destination": "/synq/guides", "permanent": true},
    {"source": "/guides.html", "destination": "/synq/guides", "permanent": true},
    {"source": "/guides/img/:file", "destination": "/synq/guides/img/:file", "permanent": true},
    {"source": "/guides/:slug.html", "destination": "/synq/guides/:slug", "permanent": true},
    {"source": "/guides/:slug", "destination": "/synq/guides/:slug", "permanent": true}
  ],
  "rewrites": [
    {"source": "/", "destination": "/index.html"},
    {"source": "/help", "destination": "/help.html"},
    {"source": "/support", "destination": "/support.html"},
    {"source": "/privacy", "destination": "/privacy.html"},
    {"source": "/terms", "destination": "/terms.html"},
    {"source": "/music-check-privacy", "destination": "/music-check-privacy.html"},
    {"source": "/synqtag-privacy", "destination": "/synqtag-privacy.html"},
    {"source": "/music-check", "destination": "/music-check.html"},
    {"source": "/synqtag", "destination": "/synqtag.html"},
    {"source": "/delete-account", "destination": "/delete-account.html"},
    {"source": "/get", "destination": "/get.html"},
    {"source": "/changelog", "destination": "/changelog.html"},
    {"source": "/synq", "destination": "/synq/index.html"},
    {"source": "/synq/guides", "destination": "/synq/guides.html"},
    {"source": "/synq/guides/:slug", "destination": "/synq/guides/:slug.html"},
    {"source": "/kagezan", "destination": "/kagezan.html"},
    { "source": "/kagezan/news", "destination": "/kagezan/news.html" },
    { "source": "/kagezan/news/:slug", "destination": "/kagezan/news/:slug.html" },
    {"source": "/kagezan-privacy", "destination": "/kagezan-privacy.html"},
    {"source": "/kagezan-terms", "destination": "/kagezan-terms.html"},
    {"source": "/kagezan-support", "destination": "/kagezan-support.html"},
    {"source": "/kagezan-delete-account", "destination": "/kagezan-delete-account.html"},
    {"source": "/admin/share", "destination": "/admin/share.html"},
    {"source": "/s/:code", "destination": "/s.html"}
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
